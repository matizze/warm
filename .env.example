APP_NAME=WARM
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database (PostgreSQL + pgvector) ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=warm_laravel
DB_USERNAME=warm
DB_PASSWORD=warm_pass

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Deve ser maior que o jobTimeout dos jobs de mídia/indexação (300s).
DB_QUEUE_RETRY_AFTER=330
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- S3 / RustFS (Laravel Herd) ---
AWS_ACCESS_KEY_ID=herd
AWS_SECRET_ACCESS_KEY=secretkey
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=warm-media
AWS_ENDPOINT=http://localhost:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# --- WARM: provider (evolution) ---
WHATSAPP_PROVIDER=evolution

# --- WARM: Evolution ---
EVOLUTION_URL=https://your-evolution-host
EVOLUTION_API_KEY=your-api-key-here
EVOLUTION_INSTANCE_ID=instance1

# --- WARM: webhook / admin auth ---
WEBHOOK_TOKEN=change-me
# Empty disables POST /admin/reindex (returns 404).
ADMIN_TOKEN=
# Bearer token for the HTTP MCP endpoint (POST /mcp). Empty disables it (404).
MCP_TOKEN=

# --- WARM: storage driver (s3 | local) ---
STORAGE_DRIVER=s3
STORAGE_LOCAL_PATH=.warm-media
MEDIA_SIGNED_URL_TTL=3600

# --- WARM: media processing (PDF/audio/image) ---
PROCESSING_ENABLED=true
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
TRANSCRIPTION_MODEL=whisper-1
VISION_MODEL=gpt-4o-mini

# --- WARM: embeddings / semantic search ---
EMBEDDING_ENABLED=true
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# --- WARM: scheduled reindex ---
REINDEX_ENABLED=true
REINDEX_CRON="0 3 * * *"
REINDEX_TZ=America/Sao_Paulo
