# Database
DATABASE_URL=postgresql://warm:warm_pass@localhost:5433/warm

# Provider (evolution | zapi | whatsmeow)
WHATSAPP_PROVIDER=evolution

# Evolution Provider
EVOLUTION_URL=https://your-evolution-host
EVOLUTION_API_KEY=your-api-key-here
EVOLUTION_INSTANCE_ID=instance1

# Webhook authentication
WEBHOOK_TOKEN=change-me

# Object storage. STORAGE_DRIVER=s3 (default) uses S3/MinIO; "local" writes to disk (dev only).
STORAGE_DRIVER=s3
STORAGE_LOCAL_PATH=./.warm-media
# For real AWS S3, drop S3_ENDPOINT and set region + keys.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=warm-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
MEDIA_SIGNED_URL_TTL=3600

# Media content processing (PDF text, audio transcription, image description)
PROCESSING_ENABLED=true
OPENAI_API_KEY=
# Optional OpenAI-compatible endpoint
OPENAI_BASE_URL=https://api.openai.com/v1
TRANSCRIPTION_MODEL=whisper-1
VISION_MODEL=gpt-4o-mini

# Semantic search (pgvector). Requires OPENAI_API_KEY.
EMBEDDING_ENABLED=true
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Scheduled embedding reindex (scheduler service / pnpm scheduler)
REINDEX_ENABLED=true
REINDEX_CRON=0 3 * * *
REINDEX_TZ=America/Sao_Paulo

# Admin HTTP endpoint token (POST /admin/reindex). Empty = disabled.
ADMIN_TOKEN=

# Server
PORT=3000
