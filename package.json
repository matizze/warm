{
  "name": "warm",
  "version": "1.0.0",
  "description": "WARM — WhatsApp Agent",
  "main": "dist/index.js",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "build": "tsc",
    "start": "tsx src/index.ts",
    "mcp": "tsx src/mcp.ts",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/infrastructure/persistence/migrate.ts",
    "reindex": "tsx src/scripts/reindex.ts",
    "scheduler": "tsx src/scripts/scheduler.ts",
    "test": "vitest run",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "dotenv": "^16.3.1",
    "express": "^4.22.3",
    "node-cron": "^4.6.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.11.3",
    "uuid": "^9.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.43",
    "@types/node-cron": "^3.0.11",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.23.1",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1"
  }
}
