APP_NAME=WARM
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://warm.example.com

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- Database (PostgreSQL + pgvector) ---
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=warm_laravel
DB_USERNAME=warm
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=database
# Deve ser maior que o jobTimeout dos jobs de mídia/indexação (300s).
DB_QUEUE_RETRY_AFTER=330
CACHE_STORE=database

# --- WARM: storage driver (s3 | local) ---
STORAGE_DRIVER=s3
STORAGE_LOCAL_PATH=.warm-media
MEDIA_SIGNED_URL_TTL=3600

# --- S3 / MinIO ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=warm-media
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# --- WARM: provider (evolution) ---
WHATSAPP_PROVIDER=evolution
EVOLUTION_URL=
EVOLUTION_API_KEY=
# Seeds the default instance on first migrate (table `instances`). Use a URL-safe
# slug; it is the Evolution instance name and appears in the URL path. Extra
# instances are rows in `instances` (per-instance webhook/mcp tokens).
EVOLUTION_INSTANCE_ID=instance1

# --- WARM: webhook / admin auth ---
WEBHOOK_TOKEN=change-me
# Empty disables POST /admin/reindex (returns 404).
ADMIN_TOKEN=
# Bearer token for the HTTP MCP endpoint (POST /mcp). Empty disables it (404).
MCP_TOKEN=

# --- WARM: media processing (PDF/audio/image) ---
PROCESSING_ENABLED=true
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
TRANSCRIPTION_MODEL=whisper-1
VISION_MODEL=gpt-4o-mini

# --- WARM: embeddings / semantic search (pgvector) ---
EMBEDDING_ENABLED=true
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# --- WARM: scheduled reindex ---
REINDEX_ENABLED=true
REINDEX_CRON="0 3 * * *"
REINDEX_TZ=America/Sao_Paulo

# --- Container toggles ---
RUN_MIGRATIONS=false
RUN_SEEDERS=false
