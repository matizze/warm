{
    "mcpServers": {
        "laravel-boost": {
            "command": "php",
            "args": [
                "artisan",
                "boost:mcp"
            ]
        },
        "warm": {
            "command": "php",
            "args": [
                "artisan",
                "mcp:serve"
            ]
        }
    }
}
